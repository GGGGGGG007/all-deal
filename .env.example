# Supabase (프로젝트 생성 후 Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 자동결제(빌링) - 개발 단계에서는 테스트 키 사용
TOSS_SECRET_KEY=test_sk_docs_ovk5rk8nE2x6mp5MZzp4gy1
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_docs_Ovk5rk8nE2x6mp5MZzp4gy1

# SMS OTP 발송 (알리고 예시 - 다른 공급자로 교체 가능)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# OTP 검증 토큰 서명용 (openssl rand -base64 32 등으로 생성)
JWT_SECRET=

# 관리자 로그인 (bcrypt 해시값. 평문 비밀번호를 저장하지 말 것)
# 생성: node -e "console.log(require('bcryptjs').hashSync('원하는비밀번호', 10))"
# 주의: Next.js는 .env 파일에서 $VAR를 변수 치환으로 해석하므로 해시의 $는 \$로 이스케이프할 것
# 예: $2b$10$abc... -> \$2b\$10\$abc...
ADMIN_PASSWORD_HASH=

# Vercel Cron 인증용 (openssl rand -hex 32 등으로 생성)
CRON_SECRET=

# 카카오톡 공유하기 (developers.kakao.com에서 앱 생성 후 JavaScript 키 발급,
# 플랫폼 > Web에 이 서비스 도메인을 등록해야 동작함)
NEXT_PUBLIC_KAKAO_JS_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
